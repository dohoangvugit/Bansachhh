<link rel="stylesheet" href="/css/checkout.css">
<h1>Thông tin thanh toán</h1>

<form action="/checkout?totalPrice={{totalPrice}}" method="POST">

    <div class="customer-info">

        <label>Họ và tên:</label>
        <input 
            type="text" 
            name="name" 
            value="{{user.fullname}}" 
            required disabled
        >

        <label>Email:</label>
        <input 
            type="email" 
            name="email" 
            value="{{user.email}}" 
            required disabled
        >

        <label>Số điện thoại:</label>
        <input 
            type="tel" 
            name="phone" 
            value="{{user.phone}}" 
            required disabled
        >

        <label>Địa chỉ giao hàng:</label>
        <input 
            type="text" 
            name="address" 
            required
        >

    </div>

    <div class="order-summary">
        <h3>
            Tổng tiền giỏ hàng:
            {{formatPrice totalPrice}} VND
        </h3>

        <input type="hidden" name="totalPrice" value="{{totalPrice}}">
    </div>

    <button type="submit" class="payment">
        Xác nhận
    </button>

</form>