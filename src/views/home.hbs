<div id="content">
    <div id="menu-slider">
        <div id="sub-menu">
            <ul>
                <li><a href="/menu/menucomic">Truyện Tranh</a></li>
                <li><a href="/menu/menusachvn">Sách Việt Nam</a></li>
                <li><a href="/menu/menusachnn">Sách Nước Ngoài</a></li>
                <li><a href="/menu/sachgiaokhoa">Sách Giáo Khoa</a></li>
                <li><a href="/menu/truyenkinhdi">Sách Kinh Dị</a></li>
            </ul>
        </div>

        <div id="slider"></div>
    </div>

    {{#if comics}}
        <div class="book-section">
            <h2>Truyện Tranh</h2>
        </div>

        <div class="padding"></div>

        <div class="book-list">
            {{#each comics}}
                <div class="book-item">
                    <a href="/books/{{id}}">
                        <img src="{{image_url}}" alt="{{title}}" class="book-img">
                        <h3>{{title}}</h3>
                    </a>

                    <p>Giá: {{formatPrice price}} VND</p>
                </div>
            {{/each}}
        </div>

        <div class="more">
            <a href="/menu/menucomic">Xem thêm</a>
        </div>
    {{/if}}

