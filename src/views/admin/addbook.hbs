<link rel="stylesheet" href="/css/edit.css">

<div class="admin-form">

    <h2 class="form-title">Thêm sách mới</h2>

    <div class="card">
        <div class="card-body">

            <form action="/admin/add" method="POST" enctype="multipart/form-data">

                <div class="form-group">
                    <label>Tên sách</label>
                    <input type="text" name="title" placeholder="Nhập tên sách..." required>
                </div>

                <div class="form-group">
                    <label>Tác giả</label>
                    <input type="text" name="author" placeholder="Nhập tên tác giả..." required>
                </div>

                <div class="form-group">
                    <label>Thể loại</label>
                    <select name="genre" required>
                        <option value="" disabled selected>-- Chọn thể loại --</option>
                        <option value="Truyện Tranh">Truyện Tranh</option>
                        <option value="Sách Nước Ngoài">Sách Nước Ngoài</option>
                        <option value="Sách Việt Nam">Sách Việt Nam</option>
                        <option value="Sách Giáo Khoa">Sách Giáo Khoa</option>
                        <option value="Truyện Kinh Dị">Truyện Kinh Dị</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Giá tiền</label>
                    <input type="number" name="price" placeholder="10000" required>
                </div>

                <div class="form-group">
                    <label>Số lượng</label>
                    <input type="number" name="stock" min="1" placeholder="Nhập số lượng nhập kho..." required>
                </div>

                <div class="form-group">
                    <label>Hình ảnh sách</label>
                    <input type="file" name="image" accept="image/*" required>
                </div>

                <div class="form-group">
                    <label>Mô tả sách</label>
                    <textarea name="description" rows="4" placeholder="Nhập mô tả chi tiết về cuốn sách..." required></textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">Thêm mới</button>
                    <a href="/admin/bookmanager" class="btn-secondary">Hủy</a>
                </div>

            </form>

        </div>
    </div>

</div>