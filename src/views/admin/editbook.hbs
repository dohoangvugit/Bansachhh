<link rel="stylesheet" href="/css/edit.css">

<div class="admin-form">

    <h2 class="form-title">Sửa thông tin sách</h2>

    <div class="card">
        <div class="card-body">

            <form action="/admin/book/edit/{{book.id}}" method="POST" enctype="multipart/form-data">

                <div class="form-group">
                    <label>Tên sách</label>
                    <input type="text" name="title" value="{{book.title}}">
                </div>

                <div class="form-group">
                    <label>Tác giả</label>
                    <input type="text" name="author" value="{{book.author}}">
                </div>

                <div class="form-group">
                    <label>Thể loại</label>
                    <select name="genre">
                        <option value="Truyện Tranh" {{#if (eq book.genre "Truyện Tranh")}}selected{{/if}}>
                            Truyện Tranh
                        </option>

                        <option value="Sách Nước Ngoài" {{#if (eq book.genre "Sách Nước Ngoài")}}selected{{/if}}>
                            Sách Nước Ngoài
                        </option>

                        <option value="Sách Việt Nam" {{#if (eq book.genre "Sách Việt Nam")}}selected{{/if}}>
                            Sách Việt Nam
                        </option>

                        <option value="Sách Giáo Khoa" {{#if (eq book.genre "Sách Giáo Khoa")}}selected{{/if}}>
                            Sách Giáo Khoa
                        </option>

                        <option value="Truyện Kinh Dị" {{#if (eq book.genre "Truyện Kinh Dị")}}selected{{/if}}>
                            Truyện Kinh Dị
                        </option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Giá tiền</label>
                    <input type="number" step="0.01" name="price" value="{{book.price}}">
                </div>

                <div class="form-group">
                    <label>Số lượng</label>
                    <input min="0" type="number" name="stock" value="{{book.stock}}">
                </div>

                <div class="form-group">
                    <label>Hình ảnh sách</label>
                    <input type="file" name="image" accept="image/*">
                </div>

                <div class="form-group">
                    <label>Mô tả sách</label>
                    <textarea name="description" rows="4">{{book.description}}</textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">Cập nhật</button>
                    <a href="/admin/bookmanager" class="btn-secondary">Hủy</a>
                </div>

            </form>

        </div>
    </div>

</div>