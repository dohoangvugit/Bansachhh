{
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon --exec \"node --dns-result-order=ipv4first\" src/app.js",
    "sass": "sass --watch src/sass/app.scss src/public/css/app.css",
    "format": "prettier --single-quote all --tab-width 4 --write 'src/**/*.{js,scss,json,hbs}'"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.22.3",
    "express-handlebars": "^8.0.1",
    "nodemon": "^3.1.14"
  }
}

