    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-handlebars": "^8.0.1",
    "multer": "^2.1.1",
    "nodemon": "^3.1.14"
  }
}
